# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Env / Secrets
.env

# Outputs
reports/
*.pdf
out/
# Engine-generierte Previews/Demos — jeder erzeugt sie selbst
output/
# Visual-DoD-Diff-Overlays bei Golden-Mismatch (Baseline liegt in tests/fixtures/golden/)
tests/failures/
# Gate-/Diagnose-Arbeitsstand (Caches, Eingang, Messungen) — jederzeit neu rechenbar
_arbeit/

# Norm-PDFs für alle Owner (Repo ist privat — nicht public stellen!)
!knowledge/**

# DXF — nur die kanonische Symbol-Library ist getrackt
*.dxf
!assets/E-Symbole.dxf
!CAD_Symbole/Notbeleuchtungssymbole.dxf
# Vorlagen (Legende etc.) fürs ganze Team
!Vorlagen-Legende/**
# Wissens-Konvertate (z.B. Stromkreisnummer via ODA aus DWG) bleiben getrackt
!knowledge/**/*.dxf
# Muthgasse 109B: DXF (via ODA aus DWG konvertiert) + Plan-PDFs = Projekt-Assets fürs Team
!Projekte/Pläne 19., Muthgasse 109B - 2026-05-07_13-12/**

# OS
.DS_Store
Thumbs.db

# Baufeld E2: Rohordner lokal, gepusht wird die Zip (DXF komprimiert 6%)
/Projekte/Baufeld E2/
# Aichholzgasse: Rohordner lokal (DXF 139 MB > GitHub-Limit), gepusht wird die Zip
/Projekte/Aichholzgasse/

# Spike-generierte IFC-Artefakte
spikes/_demo.ifc
spikes/*.ifc

# AutoCAD-Lock-Dateien (transient, nicht versionieren)
*.dwl
*.dwl2
# AutoCAD-Backups (transient, oft >100 MB — GitHub-Killer)
*.bak

# CAD-Projekt-Rohordner lokal; gepusht werden je Projekt DXF-only-ZIPs (<100 MB).
# Die *.zip liegen direkt im Top-Ordner und bleiben getrackt.
Projekte mit Notbeleuchtung/*/
Projekte_Leere*/*/

# Rennweg OG3: Referenzplan der Stempel-Anker-Tests (ArchiCAD-Export)
!Projekte/Rennweg/**

# Sammellauf über alle Repo-Grundrisse (generiert, ~250 MB)
Projekte/_ergebnis_alle/

# Layer-Merkmalstabelle (Slice-3b-Vorarbeit): generiert von scripts/analyse/layer_merkmale.py
Projekte/_layermerkmale/
# Layer-Korpus: aus den Plänen regenerierbar, enthält Kunden-Layernamen im Klartext.
# Ob die Trainingsdaten getrackt werden, ist eine Entscheidung zu dritt — bis dahin lokal.
corpus/

# Raumerkennungs-Darstellung: Zwischenstufen je Plan (Cache + Kulisse) bleiben lokal
Projekte/_ergebnis_raumerkennung/**/_cache.pkl
Projekte/_ergebnis_raumerkennung/**/_hintergrund_*.png
Projekte/_ergebnis_raumerkennung/**/_voll.png
Projekte/_ergebnis_raumerkennung/_einzel/
