{
  "$defs": {
    "BereichsRegel": {
      "description": "Explizite LB-Vorgabe OB ein Raumtyp Sicherheitsbeleuchtung erhält.\n\n`raum_typ` muss auf Selmans RaumModell-Vokabular mappen (STIEGENHAUS/GANG/GARAGE …),\nsonst greift die Regel im Platzierer nicht. `sicherheitsbeleuchtung=False` in\n`bereiche_exklusion` ist der Hard-Override gegen den Norm-Default.",
      "properties": {
        "raum_typ": {
          "title": "Raum Typ",
          "type": "string"
        },
        "sicherheitsbeleuchtung": {
          "title": "Sicherheitsbeleuchtung",
          "type": "boolean"
        },
        "begruendung": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Begruendung"
        }
      },
      "required": [
        "raum_typ",
        "sicherheitsbeleuchtung"
      ],
      "title": "BereichsRegel",
      "type": "object"
    },
    "SonderLux": {
      "description": "Erhöhte Mindest-Beleuchtungsstärke an einem Ort (z.B. Feuerlöscher ≥ 5 lx).",
      "properties": {
        "ort": {
          "title": "Ort",
          "type": "string"
        },
        "min_lux": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Lux"
        }
      },
      "required": [
        "ort"
      ],
      "title": "SonderLux",
      "type": "object"
    }
  },
  "description": "Explizite, projektspezifische Vorgaben aus der Leistungsbeschreibung (2. Input).",
