    "Sonderstelle": {
      "description": "Hervorzuhebende Stelle nach EN 1838 §4.1.2 — punktförmig.\n\nDie Norm-Anforderung ist ein Abstand zum Gerät (Leuchte „nahe\", ANMERKUNG:\n≤ 2 m horizontal) — deshalb ein Punkt-Modell, kein Raum-Flag. Heute ist kein\nTyp automatisch aus dem Architekturplan erkennbar (Spec §4) — die Quelle ist\ni.d.R. eine manuelle Angabe; `quelle` trägt die Herkunft als Audit-Trail.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "typ": {
          "enum": [
            "feuerloescher",
            "hydrant",
            "erste_hilfe",
            "brandmelder",
            "niveauaenderung"
          ],
          "title": "Typ",
          "type": "string"
        },
        "xy_mm": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Xy Mm",
          "type": "array"
        },
        "raum_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raum Id"
        },
        "quelle": {
          "default": "",
          "title": "Quelle",
          "type": "string"
        }
      },
      "required": [
        "id",
        "typ",
        "xy_mm"
      ],
      "title": "Sonderstelle",
      "type": "object"
    },
    "StiegenhausModell": {
      "description": "v1.2.0 — Stiegenhaus-Innenleben: Läufe, Podeste, Türen, Verbotszonen.\n\n`verbotszonen_mm` = Flächen, auf denen nichts montiert/projiziert werden\ndarf (Laufflächen, Öffnungen) — Anker/Richtungen liefert die Erkennung,\ndie Platzierungslogik bleibt bei Leonis.",
      "properties": {
        "raum_id": {
          "title": "Raum Id",
          "type": "string"
        },
        "laeufe": {
          "items": {
            "$ref": "#/$defs/Treppenlauf"
          },
          "title": "Laeufe",
          "type": "array"
        },
        "podeste": {
