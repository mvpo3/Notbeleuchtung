        "id": {
          "title": "Id",
          "type": "string"
        },
        "typ": {
          "enum": [
            "PODEST",
            "ANTRITT",
            "AUSTRITT",
            "TUER",
            "RICHTUNGSWECHSEL",
            "KREUZUNG",
            "ENDE",
            "STRECKE"
          ],
          "title": "Typ",
          "type": "string"
        },
        "xy_mm": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Xy Mm",
          "type": "array"
        },
        "winkel_grad": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Winkel Grad"
        },
        "fluchtrichtung_grad": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fluchtrichtung Grad"
        },
        "raum_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raum Id"
        }
      },
      "required": [
        "id",
        "typ",
        "xy_mm"
      ],
      "title": "Anker",
      "type": "object"
    },
