{
  "$defs": {
    "ArbeitsplatzLux": {
      "description": "Arbeitsplätze mit besonderer Gefährdung (EN 1838 §4.4) — erhöhte Lux-Anforderung.\n\nv1.1.0 (Track B). Werte aus `normwissen/data` (Enis); None = kein Norm-Wert.",
      "properties": {
        "min_lux": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Lux"
        },
        "min_lux_absolut": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Lux Absolut"
        }
      },
      "title": "ArbeitsplatzLux",
      "type": "object"
    },
    "ErkennungsweiteParameter": {
      "properties": {
        "z_hinterleuchtet": {
          "default": 200.0,
          "title": "Z Hinterleuchtet",
          "type": "number"
        },
        "z_beleuchtet": {
          "default": 100.0,
          "title": "Z Beleuchtet",
          "type": "number"
        }
      },
      "title": "ErkennungsweiteParameter",
      "type": "object"
    },
    "FlaechenSchwellen": {
      "description": "Flächenbasierte Antipanik-Trigger — welche Fläche welche Pflicht auslöst.\n\nQuelle ist NICHT EN 1838 (dort kommt keine flächenbezogene Auslöse-Schwelle vor),\nsondern OVE E 8101:2019 718.560.9.001.AT bzw. ÖVE/ÖNORM E 8002-1 — dort\nscope-gebunden an „erhöhte Anforderungen nach der Art der Nutzung\" (OVE R 12-2 /\nOIB-RL 2). Der Konsument (`flaechen_strategy`) darf sie deshalb nur anwenden, wenn\nder OIB-Pfad diesen Scope bestätigt (OibBefund-Gate), nie global.\n\nv1.2.0. Werte + `quelle` kommen aus `normwissen/data` (Enis); None = Norm liefert\n(noch) keine Schwelle. Konsument fragt sie statt sie zu raten.",
      "properties": {
        "antipanik_min_m2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Antipanik Min M2"
        },
        "wc_sanitaer_min_m2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wc Sanitaer Min M2"
        },
        "quelle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quelle"
        }
      },
      "title": "FlaechenSchwellen",
      "type": "object"
    },
    "NormAnforderung": {
      "description": "Antwort der Norm-Query für einen Raum bzw. Fluchtweg-Abschnitt.",
      "properties": {
        "min_lux": {
          "title": "Min Lux",
          "type": "number"
        },
        "klassifikation": {
          "enum": [
            "rz",
            "antipanik",
            "sicherheitsleuchte"
          ],
          "title": "Klassifikation",
          "type": "string"
        },
        "montagehoehe_mm": {
          "default": 2000,
          "title": "Montagehoehe Mm",
          "type": "integer"
        },
        "erkennungsweite_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Erkennungsweite M"
        },
        "symbol_katalog_keys": {
          "items": {
            "type": "string"
          },
          "title": "Symbol Katalog Keys",
          "type": "array"
        },
        "mindest_anzahl": {
          "default": 1,
          "title": "Mindest Anzahl",
          "type": "integer"
        },
        "dauer_min": {
          "default": 60,
          "title": "Dauer Min",
          "type": "integer"
        },
        "gleichmaessigkeit_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gleichmaessigkeit Max"
        },
        "umschaltzeit_max_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Umschaltzeit Max S"
        },
        "quelle": {
          "default": "",
          "title": "Quelle",
          "type": "string"
        }
      },
      "required": [
        "min_lux",
        "klassifikation"
      ],
      "title": "NormAnforderung",
      "type": "object"
    },
    "RaumRegel": {
      "description": "Ein Eintrag im Regelwerk-Snapshot (pro Raumtyp/Fluchtweg-Klasse).",
      "properties": {
        "raum_typ": {
          "title": "Raum Typ",
          "type": "string"
        },
        "ist_fluchtweg": {
          "title": "Ist Fluchtweg",
          "type": "boolean"
        },
        "anforderung": {
          "$ref": "#/$defs/NormAnforderung"
        }
      },
      "required": [
        "raum_typ",
        "ist_fluchtweg",
        "anforderung"
      ],
      "title": "RaumRegel",
      "type": "object"
    }
  },
  "description": "Serialisierbarer Voll-Dump für den Freeze-Snapshot-Test.\n\n`quellen` = die Menge aller Quellen-Strings, die der Provider je vergibt —\ndie Naht-Invariante prüft, dass jede Platzierung.norm_quelle hierin liegt.",
  "properties": {
    "contract": {
      "const": "NormRegelwerk",
      "default": "NormRegelwerk",
      "title": "Contract",
      "type": "string"
    },
    "contract_version": {
      "default": "1.2.0",
      "title": "Contract Version",
      "type": "string"
    },
    "norm": {
      "default": "ÖNORM EN 1838:2013",
      "title": "Norm",
      "type": "string"
    },
    "erkennungsweite": {
      "$ref": "#/$defs/ErkennungsweiteParameter"
    },
    "flaechen_schwellen": {
      "$ref": "#/$defs/FlaechenSchwellen"
    },
    "arbeitsplatz_lux": {
      "$ref": "#/$defs/ArbeitsplatzLux"
    },
    "regeln": {
      "items": {
        "$ref": "#/$defs/RaumRegel"
      },
      "title": "Regeln",
      "type": "array"
    },
    "quellen": {
      "items": {
        "type": "string"
      },
      "title": "Quellen",
      "type": "array"
    }
  },
  "title": "NormRegelwerk",
  "type": "object"
}
