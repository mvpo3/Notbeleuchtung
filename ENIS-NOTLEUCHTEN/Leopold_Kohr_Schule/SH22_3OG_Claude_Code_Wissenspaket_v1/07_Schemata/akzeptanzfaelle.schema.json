{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "example_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 87
            },
            "minItems": 2,
            "maxItems": 2
          },
          "source_id": {
            "const": "ORIGINAL_PDF"
          },
          "view_crop_xyxy": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "setup": {
            "type": "string",
            "minLength": 1
          },
          "expected_claims": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "evidence_required": {
            "type": "string",
            "minLength": 1
          },
          "negative_case": {
            "type": "string",
            "minLength": 1
          },
          "unknowns_to_preserve": {
            "type": "string",
            "minLength": 1
          },
          "evaluation_status": {
            "const": "not_run"
          }
        },
        "required": [
          "case_id",
          "example_id",
          "title",
          "pages",
          "source_id",
          "view_crop_xyxy",
          "setup",
          "expected_claims",
          "evidence_required",
          "negative_case",
          "unknowns_to_preserve",
          "evaluation_status"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "purpose",
    "cases"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
