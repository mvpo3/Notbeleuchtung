{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "example_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "pdf_pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 87
            },
            "minItems": 2,
            "maxItems": 2
          },
          "original_source_id": {
            "const": "ORIGINAL_PDF"
          },
          "source_page": {
            "const": 1
          },
          "coordinate_space": {
            "const": "plan_norm_2000"
          },
          "view_crop_xyxy": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "feature_id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "explanation": {
                  "type": "string",
                  "minLength": 1
                },
                "color": {
                  "enum": [
                    "red",
                    "blue",
                    "purple",
                    "orange",
                    "cyan",
                    "green",
                    "gray"
                  ]
                }
              },
              "required": [
                "feature_id",
                "title",
                "explanation",
                "color"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "reasoning": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "heading",
                "text"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "model_consequence": {
            "type": "string",
            "minLength": 1
          },
          "counterexample": {
            "type": "string",
            "minLength": 1
          },
          "unknown_properties": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "knowledge_file": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "example_id",
          "title",
          "pdf_pages",
          "original_source_id",
          "source_page",
          "coordinate_space",
          "view_crop_xyxy",
          "location",
          "features",
          "reasoning",
          "model_consequence",
          "counterexample",
          "unknown_properties",
          "rule",
          "knowledge_file",
          "coverage"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "examples"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
