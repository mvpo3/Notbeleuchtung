{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "execution": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "example_id": {
            "type": "string",
            "minLength": 1
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 87
            },
            "minItems": 2,
            "maxItems": 2
          },
          "principle": {
            "type": "string",
            "minLength": 1
          },
          "evidence_to_check": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "reasoning": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "heading",
                "text"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "consequence": {
            "type": "string",
            "minLength": 1
          },
          "reject_shortcut": {
            "type": "string",
            "minLength": 1
          },
          "retain_unknown": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "on_conflict": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "rule_id",
          "example_id",
          "pages",
          "principle",
          "evidence_to_check",
          "reasoning",
          "consequence",
          "reject_shortcut",
          "retain_unknown",
          "scope",
          "on_conflict"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "execution",
    "rules"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
