{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "coordinate_space",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "coordinate_space": {
      "const": "sh22_1og_pdf_pt_top_left"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "rule",
          "crop_pdf_pt",
          "book_pages",
          "marks",
          "annotation_geometry_role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "crop_pdf_pt": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "book_pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 61
            }
          },
          "marks": {
            "type": "array"
          },
          "annotation_geometry_role": {
            "const": "explanatory_mark_not_exact_component_footprint"
          }
        }
      }
    }
  }
}
