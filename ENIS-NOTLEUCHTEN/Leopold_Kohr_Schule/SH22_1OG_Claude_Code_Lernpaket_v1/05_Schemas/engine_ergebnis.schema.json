{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SH22 1OG engine result adapter contract",
  "type": "object",
  "required": [
    "schema_version",
    "result_kind",
    "floor_id",
    "coordinate_space",
    "source_dxf_sha256",
    "engine_name",
    "features",
    "portals"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "result_kind": {
      "const": "engine_prediction"
    },
    "floor_id": {
      "const": "1OG"
    },
    "coordinate_space": {
      "const": "sh22_1og_pdf_pt_top_left"
    },
    "source_dxf_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "engine_name": {
      "type": "string",
      "minLength": 1
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "geometry",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "enum": [
              "wall",
              "column",
              "guard",
              "door",
              "window",
              "stair",
              "lift",
              "furniture",
              "annotation",
              "projection",
              "walkable_area",
              "room",
              "void",
              "service_area",
              "unknown"
            ]
          },
          "geometry": {
            "type": "object",
            "required": [
              "type",
              "coordinates"
            ],
            "properties": {
              "type": {
                "enum": [
                  "Point",
                  "LineString",
                  "MultiLineString",
                  "Polygon",
                  "MultiPolygon"
                ]
              },
              "coordinates": {
                "type": "array",
                "minItems": 1
              }
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "object",
            "required": [
              "status",
              "method",
              "reason",
              "source_handles",
              "label_handles"
            ],
            "properties": {
              "status": {
                "enum": [
                  "derived",
                  "user_confirmed",
                  "uncertain"
                ]
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "source_handles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "label_handles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          },
          "properties": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "portals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "segment",
          "connects",
          "status",
          "source_handles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "door",
              "open_passage"
            ]
          },
          "segment": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 2,
            "maxItems": 2
          },
          "connects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "status": {
            "enum": [
              "derived",
              "user_confirmed",
              "uncertain"
            ]
          },
          "source_handles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
